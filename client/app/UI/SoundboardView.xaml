<UserControl x:Class="RgasSoundboard.UI.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- C-3/C-5/C-8/C-9/C-10/C-17/C-37: compact mode/transport/horn controls on
         top; the collection browser (checkbox activation + per-row playlist
         play/stop) owns the bottom ~70%. -->
    <Grid Margin="28,16,28,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- Modes (C-5) -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Button x:Name="BtnMode1" AutomationProperties.Name="Mode 1 pump up" Style="{StaticResource BigButton}" Margin="0,0,12,0" Click="Mode_Click" Tag="1">
                <TextBlock Text="🔥 1 · PUMP UP" FontSize="24"/>
            </Button>
            <Button x:Name="BtnMode2" AutomationProperties.Name="Mode 2 stop-in-action" Style="{StaticResource BigButton}" Margin="0,0,12,0" Click="Mode_Click" Tag="2">
                <TextBlock Text="🏒 2 · STOP-IN-ACTION" FontSize="24"/>
            </Button>
            <Button x:Name="BtnMode3" AutomationProperties.Name="Mode 3 relax" Style="{StaticResource BigButton}" Margin="0,0,12,0" Click="Mode_Click" Tag="3">
                <TextBlock Text="🧊 3 · RELAX" FontSize="24"/>
            </Button>
            <Button x:Name="BtnMode4" AutomationProperties.Name="Mode 4 silence" Style="{StaticResource BigButton}" Click="Mode_Click" Tag="4">
                <TextBlock Text="🔇 4 · SILENCE" FontSize="24"/>
            </Button>
        </UniformGrid>

        <!-- Transport (C-8) + horn (C-9) -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="740"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPlay" Grid.Column="0" Style="{StaticResource BigButton}" Click="Play_Click">
                <TextBlock x:Name="PlayText" Text="▶  PLAY" FontSize="34"/>
            </Button>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Button x:Name="BtnOrder" DockPanel.Dock="Right" Style="{StaticResource BigButton}"
                            MinWidth="210" MinHeight="42" Click="Order_Click">
                        <TextBlock x:Name="OrderText" Text="🔀 SHUFFLE" FontSize="18"/>
                    </Button>
                    <TextBlock x:Name="TimeLeft" DockPanel.Dock="Right" Text=""
                               FontFamily="{StaticResource DisplayFont}" FontSize="30"
                               Foreground="{StaticResource IceBrush}" Margin="0,0,20,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="NowLabel" Text="—" FontFamily="{StaticResource DisplayFont}"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>
                </DockPanel>
                <ProgressBar Grid.Row="1" x:Name="Progress" Height="12" Margin="0,14,0,0"
                             Minimum="0" Maximum="1"/>
                <!-- C-44: next-up preview + skip -->
                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button x:Name="BtnSkip" DockPanel.Dock="Right" Style="{StaticResource BigButton}"
                            MinWidth="130" MinHeight="38" Click="Skip_Click"
                            ToolTip="Skip the next-up track — doesn't touch what's playing now (K)">
                        <TextBlock Text="⏭ SKIP (K)" FontSize="16"/>
                    </Button>
                    <TextBlock x:Name="NextUpText" FontFamily="{StaticResource DisplayFont}"
                               FontSize="18" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,20,0"/>
                </DockPanel>
            </Grid>

            <!-- C-42/C-45: announcer, open mic, horn - equal width (UniformGrid) -->
            <UniformGrid Grid.Column="2" Columns="3">
                <!-- C-42: announcer popup (hotkey A) -->
                <Button x:Name="BtnAnnounce" Style="{StaticResource BigButton}"
                        Margin="0,0,14,0" Click="Announce_Click">
                    <StackPanel>
                        <TextBlock Text="🎙 AI ANNOUNCEMENT" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="or press A" FontSize="14" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- C-45: open mic - live pass-through, toggled -->
                <Button x:Name="BtnOpenMic" Style="{StaticResource BigButton}"
                        Margin="0,0,14,0" Click="OpenMic_Click">
                    <StackPanel>
                        <TextBlock x:Name="OpenMicText" Text="🎤 OPEN MIC" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="or press Ctrl+O" FontSize="14" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- C-9/C-46: hold-to-sound; button shows the active horn (Ctrl+H switches) -->
                <Button x:Name="BtnHorn" Style="{StaticResource BigButton}"
                        Background="{StaticResource HornGradient}" BorderBrush="#66F0424C"
                        PreviewMouseLeftButtonDown="Horn_Down" PreviewMouseLeftButtonUp="Horn_Up"
                        MouseLeave="Horn_Up" LostMouseCapture="Horn_Up"
                        TouchDown="Horn_TouchDown" TouchUp="Horn_TouchUp" LostTouchCapture="Horn_TouchUp">
                    <StackPanel>
                        <TextBlock x:Name="HornNameText" Text="📢 STAR HORN" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="hold · or H · Ctrl+H switches" FontSize="13" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

        <!-- Collection browser (C-37) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="CollectionsHeader" Text="COLLECTIONS"
                               Style="{StaticResource PanelHeader}" Margin="4,0,0,10"/>
                    <ListBox x:Name="LbCollections" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource CollectionItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Collections_SelectionChanged"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ClipsHeader" Text="CLIPS"
                               Style="{StaticResource PanelHeader}" Margin="4,0,0,10"/>
                    <!-- Playlist (C-37): each row owns its play/stop control -->
                    <ListBox x:Name="LvClips" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ClipItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MinHeight="58" Background="Transparent">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu Opened="ClipMenu_Opened">
                                            <MenuItem Header="Move to collection" Tag="move"/>
                                            <MenuItem Header="Remove from this collection" Click="ClipRemoveFromCollection_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🗑 Delete clip from library…" Click="ClipDelete_Click"/>
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource PlayCircle}"
                                            AutomationProperties.Name="{Binding Label, StringFormat=Play {0}}"
                                            Tag="{Binding}" Click="ClipPlay_Click">
                                        <Grid>
                                            <TextBlock x:Name="IcoPlay" Text="▶" FontSize="22" Margin="4,0,0,2"/>
                                            <TextBlock x:Name="IcoStop" Text="◼" FontSize="22" Margin="0,0,0,2"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="18,0,10,0"/>
                                    <!-- animated equalizer shown on the playing row -->
                                    <StackPanel x:Name="Eq" DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center" Visibility="Collapsed" Margin="14,0,0,0">
                                        <Rectangle x:Name="EqA" Width="5" Height="26" RadiusX="2" RadiusY="2"
                                                   Fill="{StaticResource EqBarGradient}"
                                                   RenderTransformOrigin="0.5,1" Margin="0,0,4,0">
                                            <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Rectangle x:Name="EqB" Width="5" Height="26" RadiusX="2" RadiusY="2"
                                                   Fill="{StaticResource EqBarGradient}"
                                                   RenderTransformOrigin="0.5,1" Margin="0,0,4,0">
                                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Rectangle x:Name="EqC" Width="5" Height="26" RadiusX="2" RadiusY="2"
                                                   Fill="{StaticResource EqBarGradient}"
                                                   RenderTransformOrigin="0.5,1">
                                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                    </StackPanel>
                                    <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="22"
                                               Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Margin="16,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter TargetName="IcoPlay" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="IcoStop" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Eq" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource IceBrush}"/>
                                        <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="EqSb">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="EqA"
                                                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                        From="0.25" To="1" Duration="0:0:0.36"/>
                                                    <DoubleAnimation Storyboard.TargetName="EqB"
                                                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                        From="1" To="0.3" Duration="0:0:0.47"/>
                                                    <DoubleAnimation Storyboard.TargetName="EqC"
                                                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                        From="0.45" To="0.95" Duration="0:0:0.29"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="EqSb"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="HintText" FontSize="21" Foreground="{StaticResource WarnBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Text=""/>
    </Grid>
</UserControl>
