<UserControl x:Class="RgasSoundboard.UI.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="View_Drop" DragOver="View_DragOver">
    <!-- C-22..C-28, C-39: a guided flow — ① get audio in, ② trim it, ③ name it
         and file it into collections. The library below manages itself through a
         right-click menu (toggle collections, delete). Volunteer-visible (C-27). -->
    <Grid Margin="28,14,28,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="340"/>
            <RowDefinition Height="258"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ① SOURCE (C-22/C-23) -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,10" Margin="0,0,0,10">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="① SOURCE" Style="{StaticResource PanelHeader}"
                           VerticalAlignment="Center" Margin="4,0,22,0"/>
                <Button x:Name="BtnRecord" DockPanel.Dock="Left" Style="{StaticResource BigButton}"
                        MinWidth="300" MinHeight="52" Click="Record_Click">
                    <TextBlock x:Name="RecordText" Text="●  RECORD WHAT'S PLAYING" FontSize="21"/>
                </Button>
                <Button x:Name="BtnImport" DockPanel.Dock="Right" Style="{StaticResource BigButton}"
                        MinWidth="240" MinHeight="52" Click="Import_Click">
                    <TextBlock Text="📂 IMPORT A FILE…" FontSize="21"/>
                </Button>
                <TextBlock DockPanel.Dock="Right" FontSize="18" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="20,0,16,0"
                           Text="or drop an mp3 / wav / flac / m4a anywhere on this tab  →"/>
                <TextBlock x:Name="RecStatus" FontSize="19" Foreground="{StaticResource IceBrush}"
                           VerticalAlignment="Center" Margin="18,0,0,0"
                           Text="captures whatever this laptop is playing — start music, hit record"/>
            </DockPanel>
        </Border>

        <!-- ② TRIM & PREVIEW (C-24) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="② TRIM &amp; PREVIEW — drag the sliders to keep just the good part"
                           Style="{StaticResource PanelHeader}" Margin="4,0,0,0"/>
                <Grid Grid.Row="1">
                    <Canvas x:Name="WaveCanvas" Width="1800" Height="190" HorizontalAlignment="Center"
                            VerticalAlignment="Center" ClipToBounds="True"/>
                    <TextBlock x:Name="WavePlaceholder" Text="record or import audio and its waveform appears here"
                               FontSize="22" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtStart" Text="START 0:00.0" FontSize="18"
                               FontFamily="{StaticResource DisplayFont}"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SlStart" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            Margin="8,0,28,0" ValueChanged="Trim_Changed" IsMoveToPointEnabled="True"/>
                    <TextBlock Grid.Column="2" x:Name="TxtEnd" Text="END 0:00.0" FontSize="18"
                               FontFamily="{StaticResource DisplayFont}"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="3" x:Name="SlEnd" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center"
                            Margin="8,0,28,0" ValueChanged="Trim_Changed" IsMoveToPointEnabled="True"/>
                    <Button Grid.Column="4" x:Name="BtnPreview" Style="{StaticResource BigButton}" MinHeight="48"
                            Click="Preview_Click">
                        <TextBlock Text="▶ PREVIEW (this laptop)" FontSize="18"/>
                    </Button>
                    <Button Grid.Column="5" x:Name="BtnStopPreview" Style="{StaticResource BigButton}" MinHeight="48"
                            Margin="12,0,0,0" Click="StopPreview_Click">
                        <TextBlock Text="◼ STOP" FontSize="18"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ③ SAVE (C-25/C-26) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,34,0">
                    <TextBlock Text="③ SAVE TO LIBRARY" Style="{StaticResource PanelHeader}" Margin="4,0,0,8"/>
                    <TextBlock Text="CLIP NAME — what the buttons will say" FontSize="15"
                               Foreground="{StaticResource MutedBrush}" Margin="4,0,0,4"/>
                    <TextBox x:Name="TxtLabel" Style="{StaticResource WatermarkTextBox}" FontSize="22"
                             Tag="e.g.  Goal song — chorus"/>
                    <Button x:Name="BtnSave" Style="{StaticResource BigButton}" Margin="0,12,0,0"
                            Background="{StaticResource AccentGradient}" Click="Save_Click">
                        <TextBlock Text="💾 SAVE CLIP" FontSize="22"/>
                    </Button>
                    <TextBlock x:Name="SaveStatus" FontSize="17" Foreground="{StaticResource WarnBrush}"
                               Margin="4,8,0,0"
                               Text="saving trims to your selection and level-matches it to the library"/>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="62"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ADD TO COLLECTIONS — tick at least one; this decides where the clip shows up"
                               Style="{StaticResource PanelHeader}" Margin="4,0,0,0"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,4">
                        <WrapPanel x:Name="PanelAssign"/>
                    </ScrollViewer>
                    <DockPanel Grid.Row="2" VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="NEW COLLECTION:" FontSize="15"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   Margin="4,0,10,0"/>
                        <Button x:Name="BtnAddCol" DockPanel.Dock="Right" Style="{StaticResource BigButton}"
                                MinHeight="44" MinWidth="140" Click="AddCollection_Click">
                            <TextBlock Text="＋ ADD" FontSize="17"/>
                        </Button>
                        <ComboBox x:Name="CmbNewColMode" DockPanel.Dock="Right" Style="{StaticResource DarkCombo}"
                                  MinWidth="250" Margin="12,0,12,0" SelectedIndex="0">
                            <ComboBoxItem Content="for mode 1 — PUMP UP"/>
                            <ComboBoxItem Content="for mode 2 — STOP-IN-ACTION"/>
                            <ComboBoxItem Content="for mode 3 — RELAX"/>
                        </ComboBox>
                        <TextBox x:Name="TxtNewCol" Style="{StaticResource WatermarkTextBox}"
                                 Tag="e.g.  Warmup bangers"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- LIBRARY (C-26/C-39) -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LIBRARY — right-click a clip to change its collections or delete it"
                           Style="{StaticResource PanelHeader}" Margin="4,0,0,8"/>
                <ListBox x:Name="LvLibrary" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource ClipItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseRightButtonDown="Library_RightDown"
                         ContextMenuOpening="Library_MenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel MinHeight="46">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Collections}" FontSize="17"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                                <TextBlock Text="{Binding Label}" FontSize="20"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
