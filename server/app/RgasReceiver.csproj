<Project Sdk="Microsoft.NET.Sdk">

  <!-- rgas-booth receiver — SPEC S-1: self-contained single-file, copy-and-run.
       S-16: windowed status dashboard (WPF).
       Publish: dotnet publish -c Release -r win-x64 -o ../publish -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RgasReceiver</AssemblyName>
    <RootNamespace>RgasReceiver</RootNamespace>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- InvariantGlobalization is NOT set: WPF's font cache requires real
         cultures and crashes with CultureNotFoundException under it. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- The publish output is the complete booth folder: deployment scripts and
       docs ride along flat next to the exe (SPEC S-11; deploy/ is the source
       of truth, publish/ is generated and gitignored). -->
  <ItemGroup>
    <DeployFiles Include="..\deploy\*.*" />
    <DeployFiles Include="..\config.example.json" />
  </ItemGroup>
  <Target Name="CopyDeployFiles" AfterTargets="Publish">
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
